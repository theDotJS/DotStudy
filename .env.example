# Copie este arquivo para .env e preencha os valores.
# O .env NAO vai para o Git. Este .env.example vai.

# ---- Banco de dados local (docker compose up -d) ----
POSTGRES_USER=dotstudy
POSTGRES_PASSWORD=troque-esta-senha-localmente
POSTGRES_DB=dotstudy
# Porta do Postgres na SUA maquina. Deixe 5432.
# Se der "port is already allocated", ja tem outro Postgres ai:
# troque para 5433 aqui E na DATABASE_URL abaixo.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://dotstudy:troque-esta-senha-localmente@localhost:5432/dotstudy?schema=public"

# ---- API (apps/api) ----
API_PORT=3333
# Somente o endereco do frontend pode chamar a API. Nada de "*". (tarefa S4 de Seguranca)
CORS_ORIGIN=http://localhost:3000

# ---- Autenticacao ----
# Segredo que assina o token de login. Cada pessoa gera o SEU, com no minimo 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Quem tem este valor consegue se passar por qualquer usuario. Nunca vai para o Git.
JWT_SEGREDO=gere-o-seu-com-o-comando-acima
# Quanto tempo o login dura. PROVISORIO: o Gabriel decide (decisao C2 do contrato).
JWT_EXPIRACAO=7d

# ---- Regra de negocio configuravel. Nao fixar no codigo. ----
# Percentual minimo de acerto para concluir um nivel. Ver docs/regras-de-negocio.md
NOTA_DE_CORTE=70

# ---- Frontend (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:3333
